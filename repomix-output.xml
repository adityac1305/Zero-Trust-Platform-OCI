<file path="ansible/roles/k3s/tasks/storage.yaml">
---

#################################################
# FIXED DATA DISK (/dev/sdb → /data)
#################################################

- name: Set data disk device (explicit OCI volume)
  ansible.builtin.set_fact:
    k3s_data_disk: /dev/sdb
    k3s_data_label: platform-data

- name: Validate data disk exists
  ansible.builtin.stat:
    path: "{{ k3s_data_disk }}"
  register: k3s_disk_check

- name: Fail if disk not found
  ansible.builtin.fail:
    msg: "Data disk {{ k3s_data_disk }} not found"
  when: not k3s_disk_check.stat.exists


#################################################
# FORMAT DISK SAFELY
#################################################

- name: Check filesystem type
  ansible.builtin.command:
    cmd: blkid -o value -s TYPE {{ k3s_data_disk }}
  register: k3s_fs_type
  failed_when: false
  changed_when: false


- name: Check existing filesystem information
  ansible.builtin.command:
    cmd: blkid {{ k3s_data_disk }}
  register: k3s_blkid_result
  failed_when: false
  changed_when: false


#################################################
# SAFETY CHECK BEFORE FORMAT
#################################################

- name: Check if disk is already mounted
  ansible.builtin.command:
    cmd: findmnt {{ k3s_data_disk }}
  register: k3s_disk_mount_check
  failed_when: false
  changed_when: false


- name: Skip formatting when disk is already mounted
  ansible.builtin.debug:
    msg: "{{ k3s_data_disk }} already mounted, skipping format"
  when:
    - k3s_disk_mount_check.rc == 0


#################################################
# FORMAT ONLY IF REQUIRED
#################################################

- name: Format disk with ext4 + label
  ansible.builtin.command:
    cmd: mkfs.ext4 -F -L {{ k3s_data_label }} {{ k3s_data_disk }}
  changed_when: true
  when:
    - k3s_fs_type.stdout != "ext4"
    - k3s_disk_mount_check.rc != 0


#################################################
# GET UUID (SAFE MOUNT METHOD)
#################################################

- name: Get disk UUID
  ansible.builtin.command:
    cmd: blkid -s UUID -o value {{ k3s_data_disk }}
  register: k3s_disk_uuid
  changed_when: false


- name: Set UUID fact
  ansible.builtin.set_fact:
    k3s_data_uuid: "{{ k3s_disk_uuid.stdout }}"


#################################################
# MOUNT /data
#################################################

- name: Create /data root directory
  ansible.builtin.file:
    path: /data
    state: directory
    mode: "0755"


- name: Mount data disk using UUID
  ansible.posix.mount:
    path: /data
    src: "UUID={{ k3s_data_uuid }}"
    fstype: ext4
    opts: defaults,nofail,x-systemd.device-timeout=30
    state: mounted


- name: Persist mount in fstab
  ansible.posix.mount:
    path: /data
    src: "UUID={{ k3s_data_uuid }}"
    fstype: ext4
    opts: defaults,nofail,x-systemd.device-timeout=30
    state: present


#################################################
# DIRECTORY STRUCTURE
#################################################

- name: Create required /data structure
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    mode: "{{ item.mode }}"
  loop:
    - {path: /data/applications, owner: ubuntu, mode: "0755"}
    - {path: /data/platform, owner: root, mode: "0755"}
    - {path: /data/platform/kubernetes, owner: root, mode: "0755"}
    - {path: /data/platform/kubernetes/k3s, owner: root, mode: "0755"}
</file>

<file path="helm/infrastructure/gateway-config/gateway.yaml">
---
# helm/infrastructure/gateway-config/gateway.yaml
#
# The Gateway resource defines the actual listeners (ports 80 + 443) that
# Envoy Gateway programs into the Envoy proxy data plane.
#
# Port 80  — HTTP only, used for:
#             a) Let's Encrypt HTTP-01 ACME challenge responses
#             b) Redirecting all other HTTP traffic to HTTPS
#             Applications should NOT serve on HTTP directly.
#
# Port 443 — HTTPS with TLS termination. cert-manager provisions and rotates
#             the wildcard certificate automatically via letsencrypt-prod.
#             Individual HTTPRoutes attach to this listener by referencing
#             this Gateway as their parentRef.
#
# The wildcard cert *.ac1305-lab.duckdns.org covers:
#   vault.ac1305-lab.duckdns.org
#   keycloak.ac1305-lab.duckdns.org
#   auth.ac1305-lab.duckdns.org   (oauth2-proxy)
#   <any-app>.ac1305-lab.duckdns.org
#
# After applying, Envoy Gateway creates a managed Envoy deployment and a
# LoadBalancer Service in envoy-gateway-system. On k3s the LoadBalancer
# is satisfied by k3s's built-in servicelb (formerly klipper-lb).
# The external IP should match your OCI instance public IP: 155.133.4.76
# Verify with: kubectl get gateway lab-gateway -n envoy-gateway-system
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: lab-gateway
  namespace: envoy-gateway-system
  labels:
    app.kubernetes.io/name: envoy-gateway
    app.kubernetes.io/part-of: gateway-config
spec:
  gatewayClassName: envoy
  listeners:
    # ── HTTP listener ─────────────────────────────────────────────────────────
    - name: http
      protocol: HTTP
      port: 80
      # Allow HTTPRoutes from any namespace to attach to this listener.
      # Individual component HTTPRoutes (vault, keycloak, etc.) live in
      # their own namespaces and need cross-namespace attachment.
      allowedRoutes:
        namespaces:
          from: All

    # -- HTTPS listener
    # TLS is terminated here at the Envoy proxy layer. App pods receive plain HTTP internally.
    # certificateRefs lists one cert per subdomain -- Envoy picks the correct cert per request using SNI.
    # Start with gateway-default-tls (base domain)
    # When adding an app, add its cert here alongside its HTTPRoute.
    - name: https
      protocol: HTTPS
      port: 443
      tls:
        mode: TERMINATE
        certificateRefs:
          - name: gateway-default-tls                        # issued for ac1305-lab.duckdns.org
            namespace: envoy-gateway-system
            kind: Secret
      allowedRoutes:
        namespaces:
          from: All
</file>

<file path="helm/platform/cert-manager/values.yaml">
---
# helm/platform/cert-manager/values.yaml
#
# cert-manager v1.20.x — tuned for a k3s single-node ARM64 OCI instance.
#
# To upgrade cert-manager: change version in
# helmrelease.yaml → merge to main.

# ── CRD management ───────────────────────────────────────────────────────────
# enabled=true → Helm owns the CRDs and handles schema migrations on upgrade.
# keep=true    → CRDs (and all your issued TLS certs) survive `helm uninstall`.
#                Only set keep=false if you want a complete wipe including certs.
crds:
  enabled: true
  keep: true

# ── Replica count ────────────────────────────────────────────────────────────
# 1 is correct for a single-node k3s cluster. Increase to 2 if you add nodes.
replicaCount: 1

# ── Feature gates ────────────────────────────────────────────────────────────
# ExperimentalGatewayAPISupport: required for cert-manager to solve ACME
# HTTP-01 challenges via Gateway API HTTPRoute resources.
# Without this, Let's Encrypt challenges fail silently with Envoy Gateway.
featureGates: "ExperimentalGatewayAPISupport=true"

# ── Controller (main cert-manager pod) ───────────────────────────────────────
nodeSelector:
  kubernetes.io/os: linux

resources:
  requests:
    cpu: 50m
    memory: 64Mi
  limits:
    cpu: 250m
    memory: 256Mi

# ── Webhook ──────────────────────────────────────────────────────────────────
# Validates and mutates Certificate, CertificateRequest,
# and Issuer resources.
webhook:
  replicaCount: 1
  timeoutSeconds: 10
  nodeSelector:
    kubernetes.io/os: linux
  resources:
    requests:
      cpu: 25m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 64Mi

# ── CA Injector ──────────────────────────────────────────────────────────────
# Injects CA bundles into webhook configurations and CRD conversion webhooks.
# Must remain enabled — disabling it breaks cert-manager's own admission webhooks.
cainjector:
  enabled: true
  replicaCount: 1
  nodeSelector:
    kubernetes.io/os: linux
  resources:
    requests:
      cpu: 25m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 64Mi

# ── Startup API check ────────────────────────────────────────────────────────
# One-shot Job that probes the cert-manager API after install/upgrade.
# Acts as the readiness gate for --wait/--atomic in helm-cd.yaml.
# Keep enabled — if disabled, helm-cd may declare success before cert-manager
# is actually ready to issue certificates.
startupapicheck:
  enabled: true
  nodeSelector:
    kubernetes.io/os: linux
  resources:
    requests:
      cpu: 10m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 64Mi

# ── Prometheus metrics ───────────────────────────────────────────────────────
# Disabled — no Prometheus stack installed. Enable when you add monitoring.
prometheus:
  enabled: false

# ── Log level ────────────────────────────────────────────────────────────────
# 2 = standard info logging. Set to 4-6 when debugging ACME challenge failures.
#logLevel: 2

# ── Global settings ──────────────────────────────────────────────────────────
global:
  # leaderElection namespace must match the install namespace (cert-manager).
  # Required even with replicaCount=1 — the controller
  # always runs leader election.
  leaderElection:
    namespace: cert-manager
</file>

