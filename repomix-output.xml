name: Ansible CI

on:
  pull_request:
    paths:
      - "ansible/**"
  workflow_dispatch:

jobs:

  syntax:
    name: Ansible Syntax Check
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Install Ansible + dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y ansible python3-pip
          pip3 install --upgrade pip

      - name: Install required Ansible collections
        run: |
          ansible-galaxy collection install community.general
          ansible-galaxy collection install ansible.posix

      - name: Set Ansible config
        run: echo "ANSIBLE_CONFIG=${GITHUB_WORKSPACE}/ansible/ansible.cfg" >> $GITHUB_ENV

      - name: Syntax Check OS Bootstrap
        working-directory: ansible
        run: |
          ansible-playbook \
            -i inventories/lab/hosts.ini \
            playbooks/os-bootstrap.yml \
            --syntax-check


  lint:
    name: Ansible Lint
    runs-on: ubuntu-latest
    needs: syntax

    steps:
      - uses: actions/checkout@v4

      - name: Install Ansible + lint
        run: |
          sudo apt-get update
          sudo apt-get install -y ansible python3-pip
          pip3 install --upgrade pip ansible-lint

      - name: Install required Ansible collections
        run: |
          ansible-galaxy collection install community.general
          ansible-galaxy collection install ansible.posix

      - name: Set Ansible config
        run: echo "ANSIBLE_CONFIG=${GITHUB_WORKSPACE}/ansible/ansible.cfg" >> $GITHUB_ENV

      - name: Run ansible-lint (entire repo)
        run: |
          ansible-lint ansible/
</file>

