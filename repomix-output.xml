<file path="ansible/roles/k3s/tasks/cleanup.yaml">
# ansible/roles/k3s/tasks/cleanup.yaml
---
- name: Install K3s image cleanup cron
  ansible.builtin.cron:
    name: "K3s image cleanup"
    minute: "0"
    hour: "3"
    job: >-
      /usr/bin/crictl rmi --prune >> /var/log/k3s-cleanup.log 2>&1;
      journalctl --vacuum-time=14d >> /var/log/k3s-cleanup.log 2>&1

- name: Install containerd cache cleanup cron
  ansible.builtin.cron:
    name: "Containerd cache cleanup"
    minute: "30"
    hour: "3"
    job: >-
      find /data/platform/kubernetes/k3s/agent/containerd
      -name '*.tmp' -mtime +1 -delete >> /var/log/k3s-cleanup.log 2>&1
</file>

<file path="ansible/roles/k3s/tasks/logging.yaml">
---
- name: Ensure journald config directory exists
  ansible.builtin.file:
    path: /etc/systemd/journald.conf.d
    state: directory
    owner: root
    group: root
    mode: "0755"

- name: Configure journald retention
  ansible.builtin.copy:
    dest: /etc/systemd/journald.conf.d/k3s.conf
    owner: root
    group: root
    mode: "0644"
    content: |
      [Journal]
      SystemMaxUse=2G
      MaxRetentionSec=14day
  notify:
    - Restart journald
</file>

