<file path="helm/infrastructure/cert-config/clusterissuer-letsencrypt-prod.yaml">
---
#

apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt-prod
  labels:
    app.kubernetes.io/name: cert-manager
    app.kubernetes.io/part-of: cert-config
