---
name: Security CI

on:
  pull_request:
  workflow_dispatch:

jobs:

  yaml-lint:
    name: YAML Lint
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Install yamllint
        run: |
          python3 -m pip install --upgrade pip
          pip install yamllint

      - name: Run yamllint
        run: |
          yamllint \
            -d '{extends: default, rules: {truthy: disable}}' \
            .

  gitleaks:
    name: Gitleaks Scan
    runs-on: ubuntu-latest
    needs: yaml-lint

    permissions:
      contents: read
      pull-requests: read

    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Run Gitleaks
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
</file>

<file path="ansible/roles/k3s/tasks/prereqs.yaml">
---

- name: Install K3s dependencies
  ansible.builtin.apt:
    name:
      - curl
      - wget
      - ca-certificates
      - apt-transport-https
      - gnupg
      - software-properties-common
      - iptables
      - iproute2
      - ebtables
      - ethtool
    state: present
    update_cache: true

#################################################
# KERNEL MODULES (CRITICAL FOR K3s)
#################################################

- name: Load required kernel modules
  community.general.modprobe:
    name: "{{ item }}"
    state: present
  loop:
    - br_netfilter
    - overlay

- name: Persist kernel modules for reboot
  ansible.builtin.copy:
    dest: /etc/modules-load.d/k3s.conf
    content: |
      br_netfilter
      overlay
    mode: "0644"

#################################################
# SAFE SYSCTL FOR K3s
#################################################

- name: Enable IPv4 forwarding
  ansible.posix.sysctl:
    name: net.ipv4.ip_forward
    value: "1"
    state: present
    reload: true
    ignoreerrors: true

- name: Check bridge sysctl availability
  ansible.builtin.stat:
    path: /proc/sys/net/bridge
  register: k3s_bridge_sysctl
  changed_when: false

- name: Apply bridge netfilter sysctl (if supported)
  ansible.posix.sysctl:
    name: "{{ item }}"
    value: "1"
    state: present
    reload: true
    ignoreerrors: true
  loop:
    - net.bridge.bridge-nf-call-iptables
    - net.bridge.bridge-nf-call-ip6tables
  when: k3s_bridge_sysctl.stat.exists

#################################################
# OPTIONAL WARNING
#################################################

- name: Warn if bridge sysctl is unavailable
  ansible.builtin.debug:
    msg: "Bridge sysctl not available; kernel module may not be fully ready"
  when: not k3s_bridge_sysctl.stat.exists

#################################################
# SYSTEM NETWORKING TUNING
#################################################

- name: Ensure system networking config file exists
  ansible.builtin.copy:
    dest: /etc/sysctl.d/99-k3s.conf
    mode: "0644"
    content: |
      net.ipv4.ip_forward = 1
      net.bridge.bridge-nf-call-iptables = 1
      net.bridge.bridge-nf-call-ip6tables = 1

- name: Reload sysctl safely
  ansible.builtin.command: sysctl --system
  changed_when: false

#################################################
# Install crictl
#################################################

- name: Install container tools
  ansible.builtin.apt:
    name:
      - cri-tools
    state: present
</file>

