<file path="helm/infrastructure/gateway-config/gatewayclass.yaml">
---
# helm/infrastructure/gateway-config/gatewayclass.yaml
#
# GatewayClass tells Envoy Gateway that it is responsible for managing
# any Gateway resource that references this class.
#
# controllerName MUST match config.envoyGateway.gateway.controllerName
# in helm/platform/envoy-gateway/values.yaml exactly.
#
# This is a cluster-scoped resource — no namespace needed.
apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: envoy
  labels:
    app.kubernetes.io/name: envoy-gateway
    app.kubernetes.io/part-of: gateway-config
spec:
  controllerName: gateway.envoyproxy.io/gatewayclass-controller
  description: "Envoy Gateway — manages ingress for ac1305-lab"
</file>

<file path="helm/infrastructure/gateway-config/httproute-redirect.yaml">
---
# helm/infrastructure/gateway-config/httproute-redirect.yaml
# 
# Permanently redirects all HTTP (port 80) traffic to HTTPS (port 443).
# Attaches only to the 'http' listener of gateway
#
# ACME HTTP-01 challenge compatibility:
# cert-manager creates a temporary HTTPRoute for /.well-known/acme-challenge/ wwith an exact path match.
# Gateway API path specificity rules mean that exact matches always win over this catch-all reirect --no conflict.

apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: http-to-https-redirect
  namespace: envoy-gateway-system
  labels:
    app.kubernetes.io/name: envoy-gateway
    app.kubernetes.io/part-of: gateway-config
spec:
  parentRefs:
    - name: lab-gateway
      namespace: envoy-gateway-system
      sectionName: http
  rules:
    - filters:
        - type: RequestRedirect
          requestRedirect:
            scheme: https
            statusCode: 301
</file>

<file path="helm/platform/cert-manager/namespace.yaml">
---
# helm/platform/cert-manager/namespace.yaml
#
# Applied by helm-cd.yaml BEFORE the helm upgrade --install so the namespace
# exists before Helm tries to create resources inside it.
#
# Pod security enforcement:
#   enforce: baseline  — cert-manager webhook + cainjector need host network
#                        access and capabilities that "restricted" blocks.
#                        "baseline" is the minimum that works. This is a
#                        documented cert-manager requirement, not a workaround.
#   warn: restricted   — logs a warning if any pod would violate restricted,
#                        without blocking it. Useful for drift detection.
#   audit: restricted  — records violations in the API server audit log.
apiVersion: v1
kind: Namespace
metadata:
  name: cert-manager
  labels:
    app.kubernetes.io/name: cert-manager
    app.kubernetes.io/part-of: cert-manager
    pod-security.kubernetes.io/enforce: baseline
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/audit: restricted
</file>

<file path="helm/platform/envoy-gateway/helmrelease.yaml">
---
# helm/platform/envoy-gateway/helmrelease.yaml
#
# THIS FILE IS READ BY helm-cd.yaml at deploy time.
# To upgrade envoy-gateway: change `version` below and merge to main.
# helm-cd.yaml reads chart_oci, version, release_name, and namespace
# from this file automatically — no changes to helm-cd.yaml needed.
#
# To install  : ensure this folder exists in git → merge to main
# To upgrade  : change version below → merge to main
# To uninstall: delete this folder from git → merge to main
#
# Envoy Gateway uses an OCI chart hosted on Docker Hub.
# No `helm repo add` is needed — OCI charts are pulled directly.
chart_oci: "oci://docker.io/envoyproxy/gateway-helm"
version: "v1.3.2"
release_name: "envoy-gateway"
namespace: "envoy-gateway-system"
</file>

<file path="helm/platform/envoy-gateway/namespace.yaml">
---
# helm/platform/envoy-gateway/namespace.yaml
#
# Applied by helm-cd.yaml BEFORE helm upgrade --install so the namespace
# exists before Helm tries to create resources inside it.
#
# Pod security enforcement:
#   enforce: privileged — Envoy Gateway's pod requires host-level network
#                         access and NET_BIND_SERVICE to bind ports 80/443.
#                         "baseline" blocks these; "privileged" is required.
#                         This is a documented Envoy Gateway requirement for
#                         the system namespace, not a workaround.
#   warn/audit: baseline — still log any drift toward less-restricted pods
#                          in other namespaces for observability.
apiVersion: v1
kind: Namespace
metadata:
  name: envoy-gateway-system
  labels:
    app.kubernetes.io/name: envoy-gateway
    app.kubernetes.io/part-of: envoy-gateway
    pod-security.kubernetes.io/enforce: privileged
    pod-security.kubernetes.io/warn: baseline
    pod-security.kubernetes.io/audit: baseline
</file>

<file path="helm/platform/envoy-gateway/values.yaml">
---
# helm/platform/envoy-gateway/values.yaml
#
# Envoy Gateway v1.3.x — tuned for a k3s single-node ARM64 OCI instance.
#
# Envoy Gateway consists of two layers:
#   1. The Gateway controller (this chart) — watches Gateway/HTTPRoute CRDs
#      and programs the data plane. Runs in envoy-gateway-system namespace.
#   2. The Envoy proxy data plane — spun up dynamically per Gateway resource
#      by the controller. Also runs in envoy-gateway-system by default.
#
# The actual Gateway resource + GatewayClass are NOT created here.
# They live in helm/infrastructure/gateway-config/ so they can be
# managed independently of the controller version.

# ── Deployment ────────────────────────────────────────────────────────────────
deployment:
  replicas: 1
  pod:
    affinity: {}
  container:
    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 512Mi

# ── Config ────────────────────────────────────────────────────────────────────
# gateway.controllerName must match the GatewayClass controllerName in
# helm/infrastructure/gateway-config/gatewayclass.yaml.
# Using the standard io.envoyproxy.gateway value.
config:
  envoyGateway:
    gateway:
      controllerName: gateway.envoyproxy.io/gatewayclass-controller
    logging:
      level:
        default: info
    provider:
      type: Kubernetes
      kubernetes:
        # The Envoy proxy pods spun up per Gateway will also run in
        # envoy-gateway-system. This keeps all gateway traffic components
        # in one namespace, simplifying network policy and RBAC.
        envoyDeployment:
          replicas: 1
          container:
            resources:
              requests:
                cpu: 100m
                memory: 64Mi
              limits:
                cpu: 500m
                memory: 256Mi
            securityContext:
              allowPrivilegeEscalation: false
              runAsNonRoot: false  # Envoy needs root to bind ports 80/443
              capabilities:
                add:
                  - NET_BIND_SERVICE
                drop:
                  - ALL

# ── CRDs ─────────────────────────────────────────────────────────────────────
# Envoy Gateway ships its own CRDs (EnvoyProxy, EnvoyPatchPolicy etc.).
# Keep enabled=true so Helm manages CRD upgrades.
crds:
  managed: true
</file>

