<file path=".github/workflows/security-ci.yaml">
---
name: Security CI

on:
  pull_request:
  workflow_dispatch:

jobs:

  yaml-lint:
    name: YAML Lint
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Install yamllint
        run: |
          python3 -m pip install --upgrade pip
          pip install yamllint

      - name: Run yamllint
        run: |
          yamllint \
            -d '{extends: default, rules: {truthy: disable, line-length: {max: 300}}}' \
            .

  gitleaks:
    name: Gitleaks Scan
    runs-on: ubuntu-latest
    needs: yaml-lint

    permissions:
      contents: read
      pull-requests: read

    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Run Gitleaks
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
</file>

<file path=".github/workflows/ansible-ci.yaml">
---

name: Ansible CI

on:
  pull_request:
    paths:
      - "ansible/**"
  workflow_dispatch:

jobs:

  syntax:
    name: Ansible Syntax Check
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-ansible
      - name: Install Ansible + dependencies
        run: |
          python3 -m pip install --upgrade pip
          pip3 install ansible

      - name: Install required Ansible collections
        run: |
          ansible-galaxy collection install community.general
          ansible-galaxy collection install ansible.posix

      - name: Set Ansible config
        run: |
          echo \
          "ANSIBLE_CONFIG=${GITHUB_WORKSPACE}/ansible/ansible.cfg" \
          >> $GITHUB_ENV

      - name: Syntax Check OS Bootstrap
        working-directory: ansible
        run: |
          ansible-playbook \
            -i inventories/lab/hosts.ini \
            playbooks/os-bootstrap.yml \
            --syntax-check


  lint:
    name: Ansible Lint
    runs-on: ubuntu-latest
    needs: syntax

    steps:
      - uses: actions/checkout@v4

      - uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-ansible

      - name: Install Ansible + lint
        run: |
          python3 -m pip install --upgrade pip
          pip3 install ansible ansible-lint

      - name: Install required Ansible collections
        run: |
          ansible-galaxy collection install community.general
          ansible-galaxy collection install ansible.posix

      - name: Set Ansible config
        run: |
          echo \
          "ANSIBLE_CONFIG=${GITHUB_WORKSPACE}/ansible/ansible.cfg" \
          >> $GITHUB_ENV

      - name: Run ansible-lint (entire repo)
        run: |
          ansible-lint ansible/

      - name: Syntax Check K3s Bootstrap
        working-directory: ansible
        run: |
          ansible-playbook \
            -i inventories/lab/hosts.ini \
            playbooks/k3s-bootstrap.yml \
            --syntax-check

      - name: Syntax Check K3s Config Rollout
        working-directory: ansible
        run: |
          ansible-playbook \
            -i inventories/lab/hosts.ini \
            playbooks/k3s-config-rollout.yml \
            --syntax-check
</file>

<file path=".github/workflows/infrastructure-deploy.yaml">
---
name: Infrastructure Deploy (CD)
on:
  push:
    branches:
      - main
    paths:
      - "opentofu/**"
      - "ansible/**"
  workflow_dispatch:
jobs:
  ############################################################
  # 0. CHANGE DETECTION
  ############################################################
  changes:
    name: Detect Change Type
    runs-on: ubuntu-latest
    outputs:
      tofu: ${{ steps.filter.outputs.tofu }}
      k3s_config: ${{ steps.filter.outputs.k3s_config }}
      k3s_version: ${{ steps.filter.outputs.k3s_version }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 2
      - name: Detect changed files
        id: filter
        run: |
          if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
            echo "tofu=true" >> $GITHUB_OUTPUT
            echo "k3s_config=true" >> $GITHUB_OUTPUT
            echo "k3s_version=true" >> $GITHUB_OUTPUT
            exit 0
          fi
          CHANGED=$(git diff --name-only HEAD^ HEAD)
          echo "$CHANGED"
          if echo "$CHANGED" | grep -q "^opentofu/"; then
            echo "tofu=true" >> $GITHUB_OUTPUT
          else
            echo "tofu=false" >> $GITHUB_OUTPUT
          fi
          K3S_CHANGED=false
          K3S_PATTERN="^ansible/(roles/k3s/|playbooks/k3s-config-rollout"
          K3S_PATTERN="${K3S_PATTERN}\.yml|roles/k3s/templates/|roles/k3s/defaults/)"
          if echo "$CHANGED" | grep -Eq "$K3S_PATTERN"; then
            K3S_CHANGED=true
          fi
          echo "k3s_config=$K3S_CHANGED" >> $GITHUB_OUTPUT
          K3S_VERSION_CHANGED=false
          K3S_VER_PATH="^ansible/roles/k3s/defaults/main.yaml"
          if echo "$CHANGED" | grep -q "$K3S_VER_PATH"; then
            K3S_VERSION_CHANGED=true
          fi
          echo "k3s_version=$K3S_VERSION_CHANGED" >> $GITHUB_OUTPUT
  ############################################################
  # 1. OPEN TOFU PLAN
  ############################################################
  plan:
    if: needs.changes.outputs.tofu == 'true'
    name: OpenTofu Plan
    runs-on: ubuntu-latest
    needs:
      - changes
    defaults:
      run:
        working-directory: opentofu/environments/lab
    env:
      AWS_ACCESS_KEY_ID: ${{ secrets.OCI_ACCESS_KEY_ID }}
      AWS_SECRET_ACCESS_KEY: ${{ secrets.OCI_SECRET_ACCESS_KEY }}
    steps:
      - uses: actions/checkout@v4
      - uses: opentofu/setup-opentofu@v1
      - name: Create OCI API Key File
        run: |
          echo "${{ secrets.OCI_PRIVATE_KEY }}" > oci_api_key.pem
          chmod 600 oci_api_key.pem
      - name: Init
        run: |
          tofu init -input=false -reconfigure
      - name: Plan
        env:
          TF_VAR_tenancy_ocid: ${{ secrets.OCI_TENANCY_OCID }}
          TF_VAR_user_ocid: ${{ secrets.OCI_USER_OCID }}
          TF_VAR_fingerprint: ${{ secrets.OCI_FINGERPRINT }}
          TF_VAR_region: ${{ secrets.OCI_REGION }}
          TF_VAR_compartment_ocid: ${{ secrets.OCI_COMPARTMENT_OCID }}
          TF_VAR_private_key_path: oci_api_key.pem
          TF_VAR_ssh_public_key: ${{ secrets.OCI_SSH_PUBLIC_KEY }}
        run: tofu plan -out=tfplan
      - name: Upload Plan
        uses: actions/upload-artifact@v4
        with:
          name: tofu-plan
          path: opentofu/environments/lab/tfplan
  ############################################################
  # 2. OPEN TOFU APPLY
  ############################################################
  apply:
    if: needs.changes.outputs.tofu == 'true'
    name: OpenTofu Apply
    runs-on: ubuntu-latest
    needs:
      - changes
      - plan
    environment:
      name: lab
    defaults:
      run:
        working-directory: opentofu/environments/lab
    env:
      AWS_ACCESS_KEY_ID: ${{ secrets.OCI_ACCESS_KEY_ID }}
      AWS_SECRET_ACCESS_KEY: ${{ secrets.OCI_SECRET_ACCESS_KEY }}
    steps:
      - uses: actions/checkout@v4
      - uses: opentofu/setup-opentofu@v1
      - name: Create OCI API Key File
        run: |
          echo "${{ secrets.OCI_PRIVATE_KEY }}" > oci_api_key.pem
          chmod 600 oci_api_key.pem
      - name: Init
        run: |
          tofu init -input=false -reconfigure
      - name: Download Plan
        uses: actions/download-artifact@v4
        with:
          name: tofu-plan
          path: opentofu/environments/lab
      - name: Apply
        run: |
          tofu apply -auto-approve tfplan
  ############################################################
  # 3. GENERATE INVENTORY
  ############################################################
  inventory:
    if: |
      always() &&
      needs.changes.result == 'success' &&
      (
        needs.changes.outputs.tofu == 'true' ||
        needs.changes.outputs.k3s_config == 'true'
      ) &&
      (
        needs.apply.result == 'success' ||
        needs.apply.result == 'skipped'
      )
    name: Generate Inventory
    runs-on: ubuntu-latest
    needs:
      - changes
      - apply
    outputs:
      vm_ip: ${{ steps.extract.outputs.vm_ip }}
      tofu: ${{ needs.changes.outputs.tofu }}
      k3s_config: ${{ needs.changes.outputs.k3s_config }}
      k3s_version: ${{ needs.changes.outputs.k3s_version }}
    env:
      AWS_ACCESS_KEY_ID: ${{ secrets.OCI_ACCESS_KEY_ID }}
      AWS_SECRET_ACCESS_KEY: ${{ secrets.OCI_SECRET_ACCESS_KEY }}
    steps:
      - uses: actions/checkout@v4
      - uses: opentofu/setup-opentofu@v1
      - name: Init
        working-directory: opentofu/environments/lab
        run: |
          tofu init -input=false -reconfigure
      - name: Extract IP
        id: extract
        working-directory: opentofu/environments/lab
        run: |
          IP=$(tofu output -raw public_ip)
          echo "vm_ip=$IP" >> $GITHUB_OUTPUT
      - name: Create inventory
        run: |
          mkdir -p inventory
          echo "[k3s]" > inventory/hosts.ini
          VM_IP="${{ steps.extract.outputs.vm_ip }}"
          echo "$VM_IP ansible_user=ubuntu" >> inventory/hosts.ini
      - name: Upload Inventory
        uses: actions/upload-artifact@v4
        with:
          name: ansible-inventory
          path: inventory/hosts.ini
  ############################################################
  # 4. FULL ANSIBLE BOOTSTRAP
  ############################################################
  ansible:
    if: |
      always() &&
      needs.inventory.result == 'success' &&
      (
        needs.inventory.outputs.tofu == 'true' ||
        needs.inventory.outputs.k3s_version == 'true'
      )
    name: Run Full Ansible Bootstrap
    runs-on: ubuntu-latest
    needs:
      - inventory
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        with:
          name: ansible-inventory
          path: inventory
      - uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-ansible
      - name: Install Ansible
        run: |
          python3 -m pip install --upgrade pip
          pip3 install ansible ansible-lint
      - name: Collections
        run: |
          ansible-galaxy collection install community.general
          ansible-galaxy collection install ansible.posix
      - name: SSH key
        run: |
          echo "${{ secrets.OCI_SSH_PRIVATE_KEY }}" > key.pem
          chmod 600 key.pem
      - name: Run site playbook
        env:
          ANSIBLE_HOST_KEY_CHECKING: False
        run: |
          ANSIBLE_CONFIG=$PWD/ansible/ansible.cfg \
          ansible-playbook \
          -i inventory/hosts.ini \
          ansible/playbooks/site.yml \
          --private-key key.pem
  ############################################################
  # 5. K3S CONFIG ONLY ROLLOUT
  ############################################################
  config-rollout:
    if: |
      always() &&
      needs.inventory.result == 'success' &&
      needs.inventory.outputs.k3s_config == 'true' &&
      (needs.ansible.result == 'success' || needs.ansible.result == 'skipped')
    name: K3s Config Rollout
    runs-on: ubuntu-latest
    needs:
      - inventory
      - ansible
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        with:
          name: ansible-inventory
          path: inventory
      - uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-ansible
      - name: Install Ansible
        run: |
          python3 -m pip install --upgrade pip
          pip3 install ansible
      - name: Install Collections
        run: |
          ansible-galaxy collection install community.general
          ansible-galaxy collection install ansible.posix
      - name: SSH Key
        run: |
          echo "${{ secrets.OCI_SSH_PRIVATE_KEY }}" > key.pem
          chmod 600 key.pem
      - name: Run K3s Config Rollout
        env:
          ANSIBLE_HOST_KEY_CHECKING: False
        run: |
          ANSIBLE_CONFIG=$PWD/ansible/ansible.cfg \
          ansible-playbook \
          -i inventory/hosts.ini \
          ansible/playbooks/k3s-config-rollout.yml \
          --private-key key.pem
</file>

