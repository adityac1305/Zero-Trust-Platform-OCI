<file path=".github/workflows/infrastructure-deploy.yaml">
---

name: Infrastructure Deploy (CD)

on:
  push:
    branches:
      - main
    paths:
      - "opentofu/**"
      - "ansible/**"

  workflow_dispatch:

jobs:

  ############################################################
  # 1. OPEN TOFU PLAN
  ############################################################
  plan:
    if: github.event_name == 'push'
    name: OpenTofu Plan
    runs-on: ubuntu-latest

    defaults:
      run:
        working-directory: opentofu/environments/lab

    env:
      AWS_ACCESS_KEY_ID: ${{ secrets.OCI_ACCESS_KEY_ID }}
      AWS_SECRET_ACCESS_KEY: ${{ secrets.OCI_SECRET_ACCESS_KEY }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup OpenTofu
        uses: opentofu/setup-opentofu@v1

      - name: Create OCI API Key File
        run: |
          echo "${{ secrets.OCI_PRIVATE_KEY }}" > oci_api_key.pem
          chmod 600 oci_api_key.pem

      - name: Initialize OpenTofu
        run: |
          tofu init -input=false -reconfigure

      - name: Generate Plan
        run: |
          tofu plan \
            -var="tenancy_ocid=${{ secrets.OCI_TENANCY_OCID }}" \
            -var="user_ocid=${{ secrets.OCI_USER_OCID }}" \
            -var="fingerprint=${{ secrets.OCI_FINGERPRINT }}" \
            -var="region=${{ secrets.OCI_REGION }}" \
            -var="compartment_ocid=${{ secrets.OCI_COMPARTMENT_OCID }}" \
            -var="private_key_path=oci_api_key.pem" \
            -var="ssh_public_key=${{ secrets.OCI_SSH_PUBLIC_KEY }}" \
            -out=tfplan

      - name: Upload Terraform Plan
        uses: actions/upload-artifact@v4
        with:
          name: tofu-plan
          path: opentofu/environments/lab/tfplan

  ############################################################
  # 2. APPLY
  ############################################################
  apply:
    if: github.event_name == 'push'
    name: OpenTofu Apply
    runs-on: ubuntu-latest
    needs: plan

    environment:
      name: lab

    defaults:
      run:
        working-directory: opentofu/environments/lab

    env:
      AWS_ACCESS_KEY_ID: ${{ secrets.OCI_ACCESS_KEY_ID }}
      AWS_SECRET_ACCESS_KEY: ${{ secrets.OCI_SECRET_ACCESS_KEY }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup OpenTofu
        uses: opentofu/setup-opentofu@v1

      - name: Create OCI API Key File
        run: |
          echo "${{ secrets.OCI_PRIVATE_KEY }}" > oci_api_key.pem
          chmod 600 oci_api_key.pem

      - name: Initialize OpenTofu
        run: |
          tofu init -input=false -reconfigure

      - name: Download Terraform Plan
        uses: actions/download-artifact@v4
        with:
          name: tofu-plan
          path: opentofu/environments/lab

      - name: Apply Infrastructure
        run: tofu apply -auto-approve tfplan

  ############################################################
  # 3. GENERATE INVENTORY
  ############################################################
  inventory:
    if: github.event_name == 'push'
    name: Generate Inventory
    runs-on: ubuntu-latest
    needs: apply

    env:
      AWS_ACCESS_KEY_ID: ${{ secrets.OCI_ACCESS_KEY_ID }}
      AWS_SECRET_ACCESS_KEY: ${{ secrets.OCI_SECRET_ACCESS_KEY }}

    outputs:
      vm_ip: ${{ steps.extract.outputs.vm_ip }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup OpenTofu
        uses: opentofu/setup-opentofu@v1

      - name: Initialize OpenTofu
        working-directory: opentofu/environments/lab
        run: |
          tofu init -input=false -reconfigure

      - name: Extract VM IP
        id: extract
        working-directory: opentofu/environments/lab
        run: |
          PUBLIC_IP=$(tofu output -raw public_ip)
          echo "vm_ip=$PUBLIC_IP" >> $GITHUB_OUTPUT

      - name: Create Inventory
        run: |
          mkdir -p inventory
          echo "[k3s]" > inventory/hosts.ini
          echo \
          "${{ steps.extract.outputs.vm_ip }} ansible_user=ubuntu" \
          >> inventory/hosts.ini

      - name: Upload Inventory
        uses: actions/upload-artifact@v4
        with:
          name: ansible-inventory
          path: inventory/hosts.ini

  ############################################################
  # 4. ANSIBLE
  ############################################################
  ansible:
    if: github.event_name == 'push'
    name: Run Ansible Bootstrap
    runs-on: ubuntu-latest
    needs: inventory

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Download Inventory
        uses: actions/download-artifact@v4
        with:
          name: ansible-inventory
          path: inventory

      - name: Install Ansible
        run: |
          sudo apt-get update
          sudo apt-get install -y ansible python3-pip
          pip3 install --upgrade pip

      - name: Install Collections
        run: |
          ansible-galaxy collection install community.general
          ansible-galaxy collection install ansible.posix

      - name: Create SSH Key
        run: |
          echo "${{ secrets.OCI_SSH_PRIVATE_KEY }}" > key.pem
          chmod 600 key.pem

      - name: Wait for SSH
        run: |
          HOST=$(awk '/^[0-9]/{print $1}' inventory/hosts.ini)

          for i in {1..30}; do
            if ssh -o StrictHostKeyChecking=no \
                 -i key.pem \
                 ubuntu@$HOST exit 0; then
              exit 0
            fi

            sleep 10
          done

          exit 1

      - name: Run Ansible Playbook
        env:
          ANSIBLE_HOST_KEY_CHECKING: "False"
        run: |
          ANSIBLE_CONFIG=$PWD/ansible/ansible.cfg \
          ansible-playbook \
            -i inventory/hosts.ini \
            ansible/playbooks/site.yml \
            --private-key key.pem
</file>

