<file path="ansible/roles/k3s/tasks/install.yaml">
---

- name: Get installed K3s version
  ansible.builtin.command:
    cmd: k3s --version
  register: k3s_installed_version
  failed_when: false
  changed_when: false

- name: Download K3s installer
  ansible.builtin.get_url:
    url: https://get.k3s.io
    dest: /tmp/k3s-install.sh
    mode: "0755"

- name: Install or upgrade K3s
  ansible.builtin.command:
    cmd: /bin/bash /tmp/k3s-install.sh
  changed_when: true
  environment:
    INSTALL_K3S_VERSION: "{{ k3s_version }}"
    INSTALL_K3S_EXEC: >-
      server --cluster-init
      --config /etc/rancher/k3s/config.yaml
  when:
    - not k3s_config_only
    - k3s_installed_version.rc != 0 or
      k3s_version not in k3s_installed_version.stdout
  notify:
    - Restart K3s

- name: Enable K3s service
  ansible.builtin.systemd:
    name: k3s
    enabled: true
    state: started

- name: Wait for K3s service
  ansible.builtin.systemd:
    name: k3s
    state: started
  register: k3s_service
  retries: 10
  delay: 15
  until: k3s_service.status.ActiveState == "active"

- name: Wait for K3s node token
  ansible.builtin.wait_for:
    path: "{{ k3s_data_dir }}/server/node-token"
    timeout: 300

- name: Verify K3s node
  ansible.builtin.command:
    cmd: kubectl --kubeconfig {{ k3s_kubeconfig_path }} get nodes
  register: k3s_nodes
  changed_when: false

- name: Display node status
  ansible.builtin.debug:
    var: k3s_nodes.stdout_lines
</file>

<file path="ansible/roles/k3s/tasks/prereqs.yaml">
---

- name: Install K3s dependencies
  ansible.builtin.apt:
    name:
      - curl
      - wget
      - ca-certificates
      - apt-transport-https
      - gnupg
      - software-properties-common
      - iptables
      - iproute2
      - ebtables
      - ethtool
    state: present
    update_cache: true

#################################################
# KERNEL MODULES (CRITICAL FOR K3s)
#################################################

- name: Load required kernel modules
  community.general.modprobe:
    name: "{{ item }}"
    state: present
  loop:
    - br_netfilter
    - overlay

- name: Persist kernel modules for reboot
  ansible.builtin.copy:
    dest: /etc/modules-load.d/k3s.conf
    content: |
      br_netfilter
      overlay
    mode: "0644"

#################################################
# SAFE SYSCTL FOR K3s
#################################################

- name: Enable IPv4 forwarding
  ansible.posix.sysctl:
    name: net.ipv4.ip_forward
    value: "1"
    state: present
    reload: true
    ignoreerrors: true

- name: Check bridge sysctl availability
  ansible.builtin.stat:
    path: /proc/sys/net/bridge
  register: k3s_bridge_sysctl
  changed_when: false

- name: Apply bridge netfilter sysctl (if supported)
  ansible.posix.sysctl:
    name: "{{ item }}"
    value: "1"
    state: present
    reload: true
    ignoreerrors: true
  loop:
    - net.bridge.bridge-nf-call-iptables
    - net.bridge.bridge-nf-call-ip6tables
  when: k3s_bridge_sysctl.stat.exists

#################################################
# OPTIONAL WARNING
#################################################

- name: Warn if bridge sysctl is unavailable
  ansible.builtin.debug:
    msg: "Bridge sysctl not available; kernel module may not be fully ready"
  when: not k3s_bridge_sysctl.stat.exists

#################################################
# SYSTEM NETWORKING TUNING
#################################################

- name: Ensure system networking config file exists
  ansible.builtin.copy:
    dest: /etc/sysctl.d/99-k3s.conf
    mode: "0644"
    content: |
      net.ipv4.ip_forward = 1
      net.bridge.bridge-nf-call-iptables = 1
      net.bridge.bridge-nf-call-ip6tables = 1

- name: Reload sysctl safely
  ansible.builtin.command: sysctl --system
  changed_when: false
</file>

