<file path="ansible/roles/k3s/tasks/install.yaml">
---

- name: Get installed K3s version
  ansible.builtin.command:
    cmd: k3s --version
  register: k3s_installed_version
  failed_when: false
  changed_when: false

- name: Download K3s install script
  ansible.builtin.get_url:
    url: https://get.k3s.io
    dest: /tmp/k3s-install.sh
    mode: "0755"

- name: Install K3s
  ansible.builtin.command: >
    /bin/bash /tmp/k3s-install.sh
  environment:
    INSTALL_K3S_VERSION: "{{ k3s_version }}"
    INSTALL_K3S_EXEC: "{{ k3s_install_args }}"
  args:
    creates: /usr/local/bin/k3s
  when:
    - k3s_installed_version.rc != 0 or
      k3s_version not in k3s_installed_version.stdout

- name: Enable K3s service
  ansible.builtin.systemd:
    name: k3s
    enabled: true
    state: started

- name: Wait for K3s node token
  ansible.builtin.wait_for:
    path: /var/lib/rancher/k3s/server/node-token
    timeout: 300

- name: Verify K3s
  ansible.builtin.command:
    cmd: k3s kubectl get nodes
  register: k3s_nodes
  changed_when: false

- name: Display node status
  ansible.builtin.debug:
    var: k3s_nodes.stdout_lines
</file>

<file path="ansible/roles/k3s/tasks/prereqs.yaml">
---

- name: Install K3s dependencies
  ansible.builtin.apt:
    name:
      - curl
      - wget
      - ca-certificates
      - apt-transport-https
      - gnupg
      - software-properties-common
      - iptables
      - iproute2
      - ebtables
      - ethtool
    state: present
    update_cache: true

#################################################
# KERNEL MODULES (CRITICAL FOR K3s)
#################################################

- name: Load required kernel modules
  ansible.builtin.modprobe:
    name: "{{ item }}"
    state: present
  loop:
    - br_netfilter
    - overlay

- name: Persist kernel modules for reboot
  ansible.builtin.copy:
    dest: /etc/modules-load.d/k3s.conf
    content: |
      br_netfilter
      overlay
    mode: "0644"

#################################################
# SYSCTL SAFE APPLICATION (OCI SAFE)
#################################################

- name: Set safe sysctl parameters for K3s
  ansible.posix.sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: present
    reload: true
    ignoreerrors: true
  loop:
    - { name: "net.ipv4.ip_forward", value: "1" }
    - { name: "net.bridge.bridge-nf-call-iptables", value: "1" }
    - { name: "net.bridge.bridge-nf-call-ip6tables", value: "1" }

#################################################
# GUARANTEE BRIDGE MODULE IS ACTIVE BEFORE SYSCTL EDGE CASES
#################################################

- name: Ensure bridge sysctl path exists before enforcing strict rules
  ansible.builtin.stat:
    path: /proc/sys/net/bridge
  register: bridge_sysctl

- name: Warn if bridge sysctl is not available
  ansible.builtin.debug:
    msg: "Bridge sysctl not available yet - kernel module may not be fully initialized"
  when: not bridge_sysctl.stat.exists

#################################################
# SYSTEM NETWORKING TUNING (K3s REQUIREMENT)
#################################################

- name: Ensure system networking config file exists
  ansible.builtin.copy:
    dest: /etc/sysctl.d/99-k3s.conf
    mode: "0644"
    content: |
      net.ipv4.ip_forward = 1
      net.bridge.bridge-nf-call-iptables = 1
      net.bridge.bridge-nf-call-ip6tables = 1

- name: Reload sysctl safely
  ansible.builtin.command: sysctl --system
  changed_when: false
</file>

<file path="opentofu/bootstrap/state-backend/main.tf">
terraform {
  required_version = ">= 1.6.0"

  required_providers {
    oci = {
      source  = "oracle/oci"
      version = ">= 5.0.0"
    }
  }
}

provider "oci" {
  tenancy_ocid     = var.tenancy_ocid
  user_ocid        = var.user_ocid
  fingerprint      = var.fingerprint
  private_key_path = var.private_key_path
  region           = var.region
}

#################################################
# OBJECT STORAGE NAMESPACE
#################################################

data "oci_objectstorage_namespace" "ns" {
  compartment_id = var.tenancy_ocid
}

#################################################
# STATE BUCKET
#################################################

resource "oci_objectstorage_bucket" "tofu_state" {
  compartment_id = var.compartment_ocid
  namespace      = data.oci_objectstorage_namespace.ns.namespace

  name = var.bucket_name

  access_type = "NoPublicAccess"

  storage_tier = "Standard"

  versioning = "Enabled"
}
</file>

